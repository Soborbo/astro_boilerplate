---
/**
 * Postcode Input Component
 * Postcode input with automatic city lookup
 */

import { siteConfig } from '@/config/calculator/site';
import { i18n } from '@/config/calculator/i18n';

interface Props {
  id?: string;
  name?: string;
  required?: boolean;
  value?: string;
  error?: string;
}

const {
  id = 'postcode',
  name = 'postcode',
  required = true,
  value,
  error,
} = Astro.props;

const t = i18n[siteConfig.locale];
const locale = siteConfig.locale;

// Locale-specific settings
const placeholder = locale === 'hu-HU' ? '1234' : 'SW1A 1AA';
const maxlength = locale === 'hu-HU' ? 4 : 8;
const pattern = locale === 'hu-HU' ? '\\d{4}' : '[A-Z]{1,2}\\d[A-Z\\d]?\\s*\\d[A-Z]{2}';
---

<div class="space-y-1">
  <label for={id} class="block text-sm font-medium text-gray-700">
    {t.postcode}
    {required && <span class="text-red-500" aria-label="required">{t.required}</span>}
  </label>

  <div class="relative">
    <input
      type="text"
      id={id}
      name={name}
      value={value}
      placeholder={placeholder}
      required={required}
      autocomplete="postal-code"
      maxlength={maxlength}
      pattern={pattern}
      class="
        w-full px-4 py-3 bg-white border-2 border-gray-300 rounded-lg
        text-gray-900 placeholder-gray-400 uppercase
        transition-all duration-200 ease-out
        focus:border-primary focus:ring-2 focus:ring-primary focus:ring-opacity-20 focus:outline-none
        hover:border-gray-400
        invalid:border-red-300 invalid:text-red-900
      "
      aria-invalid={error ? 'true' : 'false'}
      aria-describedby={error ? `${id}-error` : `${id}-loading`}
    />

    {/* Loading indicator (shown by client.ts during lookup) */}
    <div id="postcode-loading" class="hidden absolute right-3 top-1/2 -translate-y-1/2">
      <svg class="animate-spin h-5 w-5 text-primary" viewBox="0 0 24 24">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" fill="none" />
        <path
          class="opacity-75"
          fill="currentColor"
          d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"
        />
      </svg>
    </div>
  </div>

  {error && (
    <p id={`${id}-error`} class="text-sm text-red-600 flex items-center gap-1 animate-fade-in" role="alert">
      <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
        <path
          fill-rule="evenodd"
          d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z"
          clip-rule="evenodd"
        />
      </svg>
      {error}
    </p>
  )}
</div>

<style>
  /* Input focus glow effect */
  input:focus {
    box-shadow: 0 0 0 3px rgba(14, 165, 233, 0.1);
  }

  /* Respect user preferences */
  @media (prefers-reduced-motion: reduce) {
    input {
      transition: none;
    }
  }
</style>
