---
/**
 * Thank You Page
 * Confirmation page after successful form submission
 */

import CalculatorLayout from '@/layouts/CalculatorLayout.astro';
import TrustBadges from '@/components/calculator/TrustBadges.astro';
import { siteConfig } from '@/config/calculator/site';
import { i18n } from '@/config/calculator/i18n';
import { TESTIMONIALS } from '@/config/calculator/social-proof';

const t = i18n[siteConfig.locale];

// Get quote ID from URL params
const quoteId = Astro.url.searchParams.get('quoteId');
---

<CalculatorLayout title={t.thankYouTitle}>
  <main class="py-12 px-4">
    <div class="max-w-3xl mx-auto">

      {/* Success message */}
      <div class="text-center mb-12 animate-fade-in">
        {/* Success icon */}
        <div class="inline-flex items-center justify-center w-20 h-20 bg-green-100 rounded-full mb-6">
          <svg class="w-12 h-12 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M5 13l4 4L19 7"
            />
          </svg>
        </div>

        <h1 class="text-3xl md:text-5xl font-bold text-gray-900 mb-4">
          {t.thankYouTitle}
        </h1>

        <p class="text-lg md:text-xl text-gray-600 mb-6 max-w-2xl mx-auto">
          {t.thankYouMessage}
        </p>

        {quoteId && (
          <div class="inline-block px-6 py-3 bg-primary-50 border border-primary-200 rounded-lg">
            <p class="text-sm text-gray-700">
              <strong>{t.quoteNumber}:</strong>
              <span class="font-mono text-primary ml-2">{quoteId}</span>
            </p>
          </div>
        )}
      </div>

      {/* What happens next */}
      <div class="bg-white rounded-xl shadow-md p-8 mb-12 animate-fade-in-up">
        <h2 class="text-2xl font-bold text-gray-900 mb-6">Mi történik ezután?</h2>

        <div class="space-y-6">
          <div class="flex gap-4">
            <div class="flex-shrink-0">
              <div class="w-10 h-10 bg-primary-100 text-primary rounded-full flex items-center justify-center font-bold">
                1
              </div>
            </div>
            <div>
              <h3 class="font-semibold text-gray-900 mb-1">Email megerősítés</h3>
              <p class="text-gray-600">
                Küldtünk egy megerősítő emailt a megadott címre az ajánlat azonosítójával.
              </p>
            </div>
          </div>

          <div class="flex gap-4">
            <div class="flex-shrink-0">
              <div class="w-10 h-10 bg-primary-100 text-primary rounded-full flex items-center justify-center font-bold">
                2
              </div>
            </div>
            <div>
              <h3 class="font-semibold text-gray-900 mb-1">Kollégánk felveszi Önnel a kapcsolatot</h3>
              <p class="text-gray-600">
                24 órán belül felhívjuk telefonon vagy emailben válaszolunk részletes ajánlatunkkal.
              </p>
            </div>
          </div>

          <div class="flex gap-4">
            <div class="flex-shrink-0">
              <div class="w-10 h-10 bg-primary-100 text-primary rounded-full flex items-center justify-center font-bold">
                3
              </div>
            </div>
            <div>
              <h3 class="font-semibold text-gray-900 mb-1">Személyre szabott ajánlat</h3>
              <p class="text-gray-600">
                Megbeszéljük az igényeit és elkészítjük az Ön számára optimális ajánlatot.
              </p>
            </div>
          </div>
        </div>
      </div>

      {/* Trust badges */}
      <div class="mb-12 animate-fade-in-up" style="animation-delay: 0.2s;">
        <TrustBadges className="justify-center" />
      </div>

      {/* Testimonials */}
      {TESTIMONIALS.length > 0 && (
        <div class="animate-fade-in-up" style="animation-delay: 0.4s;">
          <h2 class="text-2xl font-bold text-gray-900 mb-6 text-center">Mit mondanak ügyfeleink?</h2>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            {TESTIMONIALS.slice(0, 3).map(testimonial => (
              <div class="bg-white rounded-lg shadow-md p-6 hover:shadow-lg transition-shadow">
                {/* Rating */}
                <div class="flex gap-1 mb-3">
                  {Array.from({ length: testimonial.rating }).map(() => (
                    <svg class="w-5 h-5 text-yellow-400" fill="currentColor" viewBox="0 0 20 20">
                      <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                    </svg>
                  ))}
                </div>

                {/* Text */}
                <p class="text-gray-700 mb-4 italic">"{testimonial.text}"</p>

                {/* Author */}
                <div class="border-t pt-4">
                  <p class="font-semibold text-gray-900">{testimonial.name}</p>
                  {testimonial.role && (
                    <p class="text-sm text-gray-600">{testimonial.role}</p>
                  )}
                  {testimonial.company && (
                    <p class="text-sm text-gray-600">{testimonial.company}</p>
                  )}
                </div>
              </div>
            ))}
          </div>
        </div>
      )}

      {/* CTA back to home */}
      <div class="text-center mt-12">
        <a
          href="/"
          class="inline-flex items-center gap-2 text-primary hover:text-primary-dark transition-colors font-medium"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          Vissza a főoldalra
        </a>
      </div>

    </div>
  </main>
</CalculatorLayout>

{/* GTM Conversion Event (if enabled) */}
{siteConfig.gtm.enabled && quoteId && (
  <script type="text/partytown" define:vars={{ quoteId }}>
    window.dataLayer = window.dataLayer || [];
    window.dataLayer.push({
      event: 'calculator_submission',
      quote_id: quoteId,
    });
  </script>
)}

<style>
  /* Page transition animations */
  @keyframes fade-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes fade-in-up {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fade-in {
    animation: fade-in 0.6s ease-out;
  }

  .animate-fade-in-up {
    animation: fade-in-up 0.8s ease-out;
    animation-fill-mode: both;
  }

  /* Respect user preferences */
  @media (prefers-reduced-motion: reduce) {
    .animate-fade-in,
    .animate-fade-in-up {
      animation: none;
    }
  }
</style>
