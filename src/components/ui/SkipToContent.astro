---
interface Props {
  targetId?: string;
  text?: string;
}

const { 
  targetId = 'main',
  text = 'Ugrás a tartalomhoz'
} = Astro.props;
---

<a 
  href={`#${targetId}`}
  class="skip-link"
>
  {text}
</a>

<style>
  .skip-link {
    position: absolute;
    top: -9999px;
    left: 50%;
    transform: translateX(-50%);
    padding: 0.75rem 1.5rem;
    background: #1e293b;
    color: #ffffff;
    font-weight: 500;
    text-decoration: none;
    border-radius: 0 0 0.5rem 0.5rem;
    z-index: 9999;
    transition: top 0.2s ease;
  }
  
  .skip-link:focus {
    top: 0;
    outline: 2px solid #3b82f6;
    outline-offset: 2px;
  }
  
  @media (prefers-reduced-motion: reduce) {
    .skip-link {
      transition: none;
    }
  }
</style>
