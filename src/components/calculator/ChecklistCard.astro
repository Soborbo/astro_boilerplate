---
/**
 * Checklist Card Component
 * Interactive card for multiple-choice selection with microinteractions
 */

import { formatPrice } from '@/config/calculator/i18n';
import { siteConfig } from '@/config/calculator/site';

interface Props {
  id: string;
  name: string;
  value: string;
  title: string;
  description?: string;
  icon?: string;
  price?: number;
  popular?: boolean;
}

const {
  id,
  name,
  value,
  title,
  description,
  icon,
  price,
  popular = false,
} = Astro.props;

const priceText = price !== undefined && price !== 0
  ? (price > 0 ? `+${formatPrice(price, siteConfig.locale)}` : formatPrice(price, siteConfig.locale))
  : null;
---

<label
  for={id}
  data-checkbox-card
  class="
    relative flex items-start p-5 bg-white border-2 border-gray-200 rounded-lg cursor-pointer
    transition-all duration-200 ease-out
    hover:border-primary-300 hover:shadow-md hover:bg-gray-50
    focus-within:ring-2 focus-within:ring-primary focus-within:ring-offset-2
    has-[:checked]:border-primary has-[:checked]:bg-primary-50 has-[:checked]:shadow-md
    group
  "
>
  {/* Checkbox input */}
  <input
    type="checkbox"
    id={id}
    name={name}
    value={value}
    class="
      mt-1 w-5 h-5 text-primary border-gray-300 rounded
      focus:ring-2 focus:ring-primary focus:ring-offset-2
      transition-all duration-200
      cursor-pointer
    "
  />

  {/* Content */}
  <div class="ml-4 flex-1">
    <div class="flex items-center justify-between">
      <div class="flex items-center gap-2">
        {/* Icon */}
        {icon && (
          <span class="text-2xl transition-transform duration-200 group-hover:scale-110">
            {icon}
          </span>
        )}

        {/* Title */}
        <span class="font-semibold text-gray-900 group-hover:text-primary transition-colors">
          {title}
        </span>

        {/* Popular badge */}
        {popular && (
          <span class="px-2 py-0.5 bg-accent text-white text-xs font-bold rounded">
            Népszerű
          </span>
        )}
      </div>

      {/* Price */}
      {priceText && (
        <span class={`text-sm font-semibold ${price && price > 0 ? 'text-primary' : 'text-green-600'}`}>
          {priceText}
        </span>
      )}
    </div>

    {/* Description */}
    {description && (
      <p class="mt-1 text-sm text-gray-600 leading-relaxed">
        {description}
      </p>
    )}
  </div>
</label>

<style>
  /* Smooth checkbox animation */
  input[type="checkbox"] {
    appearance: none;
    background-color: white;
    position: relative;
  }

  input[type="checkbox"]:checked {
    background-color: #0ea5e9; /* primary color */
    border-color: #0ea5e9;
  }

  input[type="checkbox"]:checked::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 0.4em;
    height: 0.75em;
    border: solid white;
    border-width: 0 0.15em 0.15em 0;
    transform: translate(-50%, -60%) rotate(45deg);
  }

  /* Prevent layout shift */
  [data-checkbox-card] {
    will-change: transform;
  }

  /* Respect user preferences */
  @media (prefers-reduced-motion: reduce) {
    [data-checkbox-card],
    [data-checkbox-card] * {
      transition: none;
    }
  }
</style>
