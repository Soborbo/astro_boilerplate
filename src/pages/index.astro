---
import Base from '../layouts/Base.astro';
import Card from '../components/ui/Card.astro';
import InView from '../components/ui/InView.astro';
import FAQ from '../components/sections/FAQ.astro';
import Testimonials from '../components/sections/Testimonials.astro';
import { siteConfig, generateFullPageSchema } from '../config/site.config';
import { t, getLocaleFromUrl } from '../config/i18n';

const locale = getLocaleFromUrl(Astro.url);
const i18n = t(locale);

// Schema.org - teljes körű
const schema = generateFullPageSchema('LocalBusiness');

const stats = [
  { value: '500+', label: 'Elégedett ügyfél' },
  { value: '10+', label: 'Év tapasztalat' },
  { value: '98%', label: 'Elégedettségi arány' },
  { value: '24h', label: 'Válaszidő' },
];

const services = [
  {
    title: '🧮 Interaktív Árkalkulátor',
    description: 'Kapj azonnali árajánlatot! Töltsd ki a kérdőívet és azonnal megkapod a becsült árat.',
    icon: '💰',
    ctaText: 'Kalkulátor indítása',
    ctaHref: '/calculator'
  },
  {
    title: 'Szolgáltatás 1',
    description: 'Rövid leírás a szolgáltatásról, ami segít a látogatónak megérteni az értéket.',
    icon: '🚀',
    ctaText: i18n.common.learnMore,
    ctaHref: '/szolgaltatas-1'
  },
  {
    title: 'Szolgáltatás 2',
    description: 'Rövid leírás a szolgáltatásról, ami segít a látogatónak megérteni az értéket.',
    icon: '💡',
    ctaText: i18n.common.learnMore,
    ctaHref: '/szolgaltatas-2'
  },
];

// FAQ - TESTRE SZABANDÓ
const faqItems = [
  {
    question: 'Mennyi idő alatt készül el a projekt?',
    answer: 'A projekt típusától függően általában 2-4 hét alatt készülünk el. Egyedi igények esetén személyre szabott ütemtervet készítünk.',
  },
  {
    question: 'Milyen garanciát vállalnak?',
    answer: 'Minden munkánkra <strong>12 hónap garanciát</strong> vállalunk. Ha bármi probléma merül fel, ingyen javítjuk.',
  },
  {
    question: 'Hogyan zajlik az együttműködés?',
    answer: 'Első lépésként egy ingyenes konzultáción felmérjük az igényeit. Ezután részletes ajánlatot küldünk, majd a szerződéskötés után kezdődik a munka.',
  },
  {
    question: 'Milyen fizetési lehetőségek vannak?',
    answer: 'Banki átutalás és készpénzes fizetés is lehetséges. Nagyobb projekteknél részletfizetést is biztosítunk.',
  },
];

// Testimonials - TESTRE SZABANDÓ
const testimonials = [
  {
    name: 'Kovács Péter',
    role: 'Ügyvezető, ABC Kft.',
    content: 'Kiváló munkát végeztek! A weboldalunk forgalma 3x-osára nőtt az átadás óta. Mindenkinek ajánlom őket.',
    rating: 5,
    date: '2024-01-15',
  },
  {
    name: 'Nagy Anna',
    role: 'Marketing vezető',
    content: 'Profi csapat, gyors kommunikáció. A kalkulátorunk naponta több tucat leadet generál.',
    rating: 5,
    date: '2024-02-20',
  },
  {
    name: 'Szabó János',
    role: 'Tulajdonos, XYZ Bt.',
    content: 'Már a második projektünk velük. Mindig időben szállítanak és a minőség kifogástalan.',
    rating: 4,
    date: '2024-03-10',
  },
];
---

<Base 
  title={`${i18n.nav.home} - ${siteConfig.name}`}
  description={siteConfig.seo.defaultDescription}
  locale={locale}
>
  <!-- Hero Section - NINCS animáció, fold felett! -->
  <section class="hero min-h-[calc(100vh-72px)] flex flex-col">
    <div class="flex-1 container mx-auto px-4 py-8 lg:py-12">
      <div class="grid lg:grid-cols-5 gap-8 lg:gap-12 items-center h-full">
        <div class="lg:col-span-3 flex flex-col justify-center order-2 lg:order-1">
          <h1 class="text-primary-600 font-semibold text-sm uppercase tracking-wide mb-3">
            SEO optimalizált főcím - kulcsszavak ide
          </h1>
          <h2 class="text-3xl sm:text-4xl lg:text-5xl xl:text-6xl font-bold text-gray-900 leading-tight mb-6 text-balance">
            Főcím ami felkelti a figyelmet
          </h2>
          <p class="text-lg lg:text-xl text-gray-600 mb-8 max-w-2xl">
            Részletesebb leírás, ami elmagyarázza az értékajánlatot és cselekvésre ösztönöz.
          </p>
          <div class="flex flex-col sm:flex-row gap-4">
            <a href="/calculator" class="btn btn-primary">
              🧮 Árkalkulátor
            </a>
            <a href="#contact" class="btn btn-secondary">{i18n.common.getQuote}</a>
          </div>
          <p class="text-sm text-gray-500 mt-4">
            💡 Használd az <strong>interaktív kalkulátort</strong> az azonnali árajánlatért
          </p>
        </div>
        <div class="lg:col-span-2 order-1 lg:order-2">
          <div class="relative aspect-[4/3] lg:aspect-[3/4] rounded-2xl overflow-hidden shadow-2xl bg-gray-200 flex items-center justify-center">
            <span class="text-gray-400">Hero kép helye</span>
            <!-- 
            Ha van kép:
            <Picture
              src={heroImage}
              formats={['avif', 'webp']}
              loading="eager"
              fetchpriority="high"
              decoding="sync"
              densities={[1, 2]}
              class="absolute inset-0 w-full h-full object-cover"
            />
            -->
          </div>
        </div>
      </div>
    </div>
    
    <!-- Stats sor - above the fold -->
    <div class="bg-gray-50 border-t border-gray-100 mt-auto">
      <div class="container mx-auto px-4 py-6 lg:py-8">
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-6 lg:gap-8">
          {stats.map((stat) => (
            <div class="text-center">
              <div class="text-2xl lg:text-3xl xl:text-4xl font-bold text-primary-600 mb-1">
                {stat.value}
              </div>
              <div class="text-sm lg:text-base text-gray-600">
                {stat.label}
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>
  
  <!-- Ügyvezető bemutatkozás -->
  <section class="py-16 lg:py-24 bg-gray-50">
    <div class="container mx-auto px-4">
      <div class="grid lg:grid-cols-2 gap-12 items-center max-w-6xl mx-auto">
        <!-- Bal oldal: Kép -->
        <div class="order-2 lg:order-1">
          <div class="aspect-[4/5] bg-gray-200 rounded-2xl overflow-hidden shadow-xl">
            <img
              src="https://via.placeholder.com/600x750/3b82f6/ffffff?text=Ugyvezeto"
              alt="Ügyvezető"
              class="w-full h-full object-cover"
              loading="lazy"
            />
          </div>
        </div>

        <!-- Jobb oldal: Szöveg -->
        <div class="order-1 lg:order-2">
          <h2 class="text-3xl lg:text-4xl font-bold text-gray-900 mb-6">
            Bemutatkozás az ügyvezetőtől
          </h2>
          <div class="prose prose-lg text-gray-600 space-y-4">
            <p>
              Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.
            </p>
            <p>
              Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat.
            </p>
            <p class="font-semibold text-gray-900">
              - Név, Ügyvezető
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Benefits szekció - Váltakozó képek -->
  <section class="py-16 lg:py-24">
    <div class="mx-auto">
      <!-- Benefit 1 - Kép bal oldalt -->
      <div class="grid lg:grid-cols-2">
        <div class="lg:w-full">
          <img
            src="https://via.placeholder.com/800x600/10b981/ffffff?text=Benefit+1"
            alt="Benefit 1"
            class="w-full h-full object-cover"
            loading="lazy"
          />
        </div>
        <div class="flex items-center" style="padding-left: 10%; padding-right: 10%;">
          <div>
            <h3 class="text-2xl lg:text-3xl font-bold text-gray-900 mb-4">
              Első előny címe
            </h3>
            <p class="text-lg text-gray-600">
              Részletes leírás az első előnyről, ami meggyőzi a látogatót.
            </p>
          </div>
        </div>
      </div>

      <!-- Benefit 2 - Kép jobb oldalt -->
      <div class="grid lg:grid-cols-2">
        <div class="flex items-center order-2 lg:order-1" style="padding-left: 10%; padding-right: 10%;">
          <div>
            <h3 class="text-2xl lg:text-3xl font-bold text-gray-900 mb-4">
              Második előny címe
            </h3>
            <p class="text-lg text-gray-600">
              Részletes leírás a második előnyről, ami meggyőzi a látogatót.
            </p>
          </div>
        </div>
        <div class="lg:w-full order-1 lg:order-2">
          <img
            src="https://via.placeholder.com/800x600/3b82f6/ffffff?text=Benefit+2"
            alt="Benefit 2"
            class="w-full h-full object-cover"
            loading="lazy"
          />
        </div>
      </div>

      <!-- Benefit 3 - Kép bal oldalt -->
      <div class="grid lg:grid-cols-2">
        <div class="lg:w-full">
          <img
            src="https://via.placeholder.com/800x600/8b5cf6/ffffff?text=Benefit+3"
            alt="Benefit 3"
            class="w-full h-full object-cover"
            loading="lazy"
          />
        </div>
        <div class="flex items-center" style="padding-left: 10%; padding-right: 10%;">
          <div>
            <h3 class="text-2xl lg:text-3xl font-bold text-gray-900 mb-4">
              Harmadik előny címe
            </h3>
            <p class="text-lg text-gray-600">
              Részletes leírás a harmadik előnyről, ami meggyőzi a látogatót.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Google Reviews szekció -->
  <section class="py-16 lg:py-24 bg-gray-50">
    <div class="container mx-auto px-4">
      <div class="text-center mb-12">
        <h2 class="text-3xl lg:text-4xl font-bold text-gray-900 mb-4">
          Ügyfeleink értékelései
        </h2>
        <p class="text-lg text-gray-600">
          Google-ön hitelesített vélemények
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 max-w-7xl mx-auto">
        {[1, 2, 3, 4, 5, 6].map(i => (
          <div class="bg-white rounded-xl shadow-lg p-6 flex flex-col">
            <!-- Review content -->
            <div class="flex-1 mb-4">
              <div class="flex gap-1 mb-3">
                {[1,2,3,4,5].map(() => (
                  <svg class="w-5 h-5 text-yellow-400" fill="currentColor" viewBox="0 0 20 20">
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                  </svg>
                ))}
              </div>
              <p class="text-gray-700 leading-relaxed">
                {i === 1 && "Kiváló szolgáltatás, professzionális csapat! Mindent időben és precízen megoldottak, csak ajánlani tudom."}
                {i === 2 && "Nagyon meg vagyok elégedve az eredménnyel. Gyors kommunikáció, rugalmas hozzáállás. Köszönöm!"}
                {i === 3 && "Profi munka, fair árak. Ez már a második projektünk együtt, és biztos hogy lesz még több is."}
                {i === 4 && "Minden elvárásunkat teljesítették. Ajánlom mindenkinek!"}
                {i === 5 && "Gyors, pontos, megbízható. Végre egy cég, amelyikre lehet számítani."}
                {i === 6 && "Remek élmény volt velük dolgozni. Mindenre volt megoldásuk, proaktívak és segítőkészek voltak."}
              </p>
            </div>

            <!-- Footer: Profil kép, név + Google logo egy sorban -->
            <div class="flex items-center justify-between border-t pt-4">
              <div class="flex items-center gap-3">
                <img
                  src={`https://via.placeholder.com/48/3b82f6/ffffff?text=${i}`}
                  alt="Profil"
                  class="w-12 h-12 rounded-full"
                />
                <div>
                  <p class="font-semibold text-gray-900">Név {i}</p>
                  <p class="text-sm text-gray-500">2 hónapja</p>
                </div>
              </div>
              <img
                src="https://www.google.com/images/branding/googlelogo/1x/googlelogo_color_74x24dp.png"
                alt="Google"
                class="h-6"
              />
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Szolgáltatások szekció - Fold ALATT, animációkkal -->
  <section id="services" class="py-16 lg:py-24">
    <div class="container mx-auto px-4">
      <InView animation="fade-up">
        <div class="text-center mb-12">
          <h2 class="text-2xl lg:text-3xl font-bold text-gray-900 mb-4">
            {i18n.nav.services}
          </h2>
          <p class="text-lg text-gray-600 max-w-2xl mx-auto">
            Rövid bevezető szöveg a szolgáltatásokhoz.
          </p>
        </div>
      </InView>
      
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
        {services.map((service, index) => (
          <InView animation="fade-up" delay={index * 100}>
            <Card
              title={service.title}
              description={service.description}
              icon={service.icon}
              ctaText={service.ctaText}
              ctaHref={service.ctaHref}
            />
          </InView>
        ))}
      </div>
    </div>
  </section>
  
  <!-- Testimonials szekció -->
  <Testimonials 
    items={testimonials}
    title="Ügyfeleink mondták"
    subtitle="Több mint 500 elégedett ügyfél"
  />
  
  <!-- FAQ szekció -->
  <FAQ 
    items={faqItems}
    title="Gyakran Ismételt Kérdések"
    subtitle="Válaszok a leggyakoribb kérdésekre"
  />
  
  <!-- Kapcsolat szekció -->
  <section id="contact" class="py-16 lg:py-24 bg-gray-50">
    <div class="container mx-auto px-4 max-w-2xl">
      <InView animation="fade-up">
        <div class="text-center mb-12">
          <h2 class="text-2xl lg:text-3xl font-bold text-gray-900 mb-4">
            {i18n.common.getQuote}
          </h2>
          <p class="text-lg text-gray-600">
            Töltse ki az alábbi űrlapot és 24 órán belül jelentkezünk.
          </p>
        </div>
      </InView>
      
      <InView animation="fade-up" delay={100}>
        <!-- Progresszív form - JS nélkül is működik, de API-val is -->
        <form 
          action="/api/submit-form" 
          method="POST"
          class="bg-white rounded-2xl shadow-lg p-8"
          id="contact-form"
        >
          <div class="space-y-6">
            <div>
              <label for="name" class="block text-sm font-medium text-gray-700 mb-2">
                {i18n.form.name} *
              </label>
              <input 
                type="text" 
                id="name" 
                name="name" 
                required
                class="form-input"
                placeholder={i18n.form.namePlaceholder}
              />
            </div>
            
            <div>
              <label for="email" class="block text-sm font-medium text-gray-700 mb-2">
                {i18n.form.email} *
              </label>
              <input 
                type="email" 
                id="email" 
                name="email" 
                required
                class="form-input"
                placeholder={i18n.form.emailPlaceholder}
              />
            </div>
            
            <div>
              <label for="phone" class="block text-sm font-medium text-gray-700 mb-2">
                {i18n.form.phone}
              </label>
              <input 
                type="tel" 
                id="phone" 
                name="phone"
                class="form-input"
                placeholder={i18n.form.phonePlaceholder}
              />
            </div>
            
            <div>
              <label for="message" class="block text-sm font-medium text-gray-700 mb-2">
                {i18n.form.message}
              </label>
              <textarea 
                id="message" 
                name="message" 
                rows="4"
                class="form-input resize-none"
                placeholder={i18n.form.messagePlaceholder}
              ></textarea>
            </div>
            
            <!-- Honeypot spam védelem -->
            <input type="text" name="website" class="honeypot" tabindex="-1" autocomplete="off" />
            
            <!-- Time-to-submit védelem -->
            <input type="hidden" name="form_start_time" id="form-start-time" />
            
            <!-- UTM hidden mezők -->
            <input type="hidden" name="utm_source" id="utm_source" />
            <input type="hidden" name="utm_medium" id="utm_medium" />
            <input type="hidden" name="utm_campaign" id="utm_campaign" />
            
            <button 
              type="submit" 
              class="btn btn-primary w-full" 
              id="submit-btn"
              data-sending-text={i18n.common.sending}
              data-error-text={i18n.form.submitError}
            >
              {i18n.common.sendMessage}
            </button>
          </div>
        </form>
      </InView>
      
      <script>
        // Form elemek lekérése
        const form = document.getElementById('contact-form');
        const startTimeInput = document.getElementById('form-start-time');
        const submitBtn = document.getElementById('submit-btn');
        let formFocusTime = null;
        
        // i18n szövegek a data attribútumokból
        const sendingText = submitBtn?.getAttribute('data-sending-text') || 'Sending...';
        const errorText = submitBtn?.getAttribute('data-error-text') || 'An error occurred. Please try again.';
        const originalBtnText = submitBtn?.textContent || 'Send';
        
        // Form focus time tracking
        if (form) {
          form.addEventListener('focusin', () => {
            if (!formFocusTime) {
              formFocusTime = Date.now();
              if (startTimeInput) {
                startTimeInput.value = formFocusTime.toString();
              }
            }
          });
        }
        
        // UTM adatok beillesztése
        const utmData = localStorage.getItem('utm_data');
        if (utmData) {
          try {
            const data = JSON.parse(utmData);
            const sourceInput = document.getElementById('utm_source');
            const mediumInput = document.getElementById('utm_medium');
            const campaignInput = document.getElementById('utm_campaign');
            
            if (sourceInput) sourceInput.value = data.utm_source || '';
            if (mediumInput) mediumInput.value = data.utm_medium || '';
            if (campaignInput) campaignInput.value = data.utm_campaign || '';
          } catch (e) {
            console.error('UTM parse error:', e);
          }
        }
        
        // Form submit kezelés AJAX-szal
        if (form && submitBtn) {
          form.addEventListener('submit', async (e) => {
            e.preventDefault();
            
            submitBtn.disabled = true;
            submitBtn.textContent = sendingText;
            
            try {
              const formData = new FormData(form);
              const data = Object.fromEntries(formData.entries());
              
              const response = await fetch('/api/submit-form', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data),
              });
              
              const result = await response.json();
              
              if (result.success) {
                // Sikeres beküldés
                localStorage.setItem('form_submitted', 'true');
                if (window.showToast) {
                  window.showToast(result.message || 'Success!', { type: 'success' });
                }
                setTimeout(() => {
                  window.location.href = '/koszonjuk';
                }, 500);
              } else {
                // Hiba - Toast használata alert helyett
                const errorMsg = result.error || errorText;
                if (window.showToast) {
                  window.showToast(errorMsg, { type: 'error', duration: 5000 });
                } else {
                  alert(errorMsg);
                }
                submitBtn.disabled = false;
                submitBtn.textContent = originalBtnText;
              }
            } catch (error) {
              console.error('Form submit error:', error);
              if (window.showToast) {
                window.showToast(errorText, { type: 'error', duration: 5000 });
              } else {
                alert(errorText);
              }
              submitBtn.disabled = false;
              submitBtn.textContent = originalBtnText;
            }
          });
        }
      </script>
    </div>
  </section>
</Base>

<style>
  .hero {
    min-height: calc(100vh - 72px);
    min-height: calc(100dvh - 72px);
  }
</style>
