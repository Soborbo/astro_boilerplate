---
/**
 * Calculator Layout
 * Base layout for all calculator pages
 */

import { siteConfig } from '@/config/calculator/site';

interface Props {
  title: string;
  description?: string;
  currentStepSlug?: string;
}

const { title, description, currentStepSlug } = Astro.props;

const pageTitle = `${title} | ${siteConfig.name}`;
const pageDescription = description || `Lead generation calculator - ${title}`;
---

<!doctype html>
<html lang={siteConfig.locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={pageDescription} />

    <title>{pageTitle}</title>

    {/* Preconnect to external resources */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    {/* Favicon */}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    {/* Fonts */}
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    {/* Prevent indexing on calculator pages (optional - remove if you want SEO) */}
    <meta name="robots" content="noindex, nofollow" />

    {/* Open Graph */}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />

    {/* Styles */}
    <style is:global>
      /* Custom calculator styles */
      body {
        background-color: #f9fafb;
      }

      /* Smooth scroll behavior */
      html {
        scroll-behavior: smooth;
      }

      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }
      }

      /* Focus visible styles for accessibility */
      *:focus-visible {
        outline: 2px solid #0ea5e9;
        outline-offset: 2px;
      }
    </style>
  </head>

  <body class="min-h-screen flex flex-col">
    {/* Skip to content link for accessibility */}
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-primary focus:text-white focus:rounded-lg"
    >
      Skip to content
    </a>

    {/* Minimal header - only logo, centered */}
    <header class="bg-white border-b border-gray-200">
      <div class="max-w-6xl mx-auto px-4 py-4 flex items-center justify-center">
        <a href="/" class="text-xl font-bold text-primary hover:text-primary-dark transition-colors">
          {siteConfig.name}
        </a>
      </div>
    </header>

    {/* Main content */}
    <main id="main-content" class="flex-1">
      <slot />
    </main>

    {/* Simple footer */}
    <footer class="bg-white border-t border-gray-200 mt-12">
      <div class="max-w-6xl mx-auto px-4 py-8 text-center text-sm text-gray-600">
        <p>© {new Date().getFullYear()} {siteConfig.name}. Minden jog fenntartva.</p>
        <div class="mt-2 space-x-4">
          <a href="/adatvedelem" class="hover:text-primary transition-colors">
            Adatvédelem
          </a>
          <a href="/aszf" class="hover:text-primary transition-colors">
            ÁSZF
          </a>
        </div>
      </div>
    </footer>

    {/* GTM (if enabled) */}
    {siteConfig.gtm.enabled && siteConfig.gtm.id && (
      <script type="text/partytown" define:vars={{ gtmId: siteConfig.gtm.id }}>
        (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
        new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
        j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
        'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
        })(window,document,'script','dataLayer', gtmId);
      </script>
    )}
  </body>
</html>
