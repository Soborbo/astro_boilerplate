---
import { siteConfig } from '../../config/site.config';
import { t, type Locale } from '../../config/i18n';

interface Props {
  locale?: Locale;
}

const { locale = 'hu' } = Astro.props;
const i18n = t(locale);
const { company, name } = siteConfig;
const currentYear = new Date().getFullYear();
---

<footer class="bg-gray-900 text-white py-12 lg:py-16">
  <div class="container mx-auto px-4">
    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-12">
      
      <!-- Cégadatok -->
      <div class="lg:col-span-2">
        <h3 class="text-lg font-semibold mb-4">{company.legalName}</h3>
        
        <address class="not-italic text-gray-400 space-y-2 mb-6">
          <p>{company.address.street}</p>
          <p>{company.address.postalCode} {company.address.city}</p>
          <p>{company.address.countryName}</p>
        </address>
        
        <!-- Kapcsolat - Reveal funkcióval (bot védelem + konverzió mérés) -->
        <div id="contact-reveal" class="space-y-3">
          <button
            id="reveal-contact-btn"
            class="inline-flex items-center gap-2 px-4 py-2 bg-primary-600 hover:bg-primary-700 text-white rounded-lg transition-colors text-sm font-medium"
            aria-expanded="false"
            aria-controls="contact-details"
            data-show-text={i18n.footer.showContact}
            data-hide-text={i18n.footer.hideContact}
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
            <span id="reveal-btn-text">{i18n.footer.showContact}</span>
          </button>
          
          <div id="contact-details" class="hidden space-y-2 text-gray-400" aria-hidden="true">
            <p>
              <a 
                href={`tel:${company.contact.phoneRaw}`}
                class="hover:text-white transition-colors inline-flex items-center gap-2"
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                </svg>
                {company.contact.phone}
              </a>
            </p>
            <p>
              <a 
                href={`mailto:${company.contact.email}`}
                class="hover:text-white transition-colors inline-flex items-center gap-2"
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                </svg>
                {company.contact.email}
              </a>
            </p>
          </div>
        </div>
      </div>
      
      <!-- Gyors linkek -->
      <div>
        <h4 class="font-semibold mb-4">{i18n.nav.services}</h4>
        <ul class="space-y-2 text-gray-400">
          <li><a href="/szolgaltatas-1" class="hover:text-white transition-colors">Szolgáltatás 1</a></li>
          <li><a href="/szolgaltatas-2" class="hover:text-white transition-colors">Szolgáltatás 2</a></li>
          <li><a href="/szolgaltatas-3" class="hover:text-white transition-colors">Szolgáltatás 3</a></li>
        </ul>
      </div>
      
      <!-- Jogi infók -->
      <div>
        <h4 class="font-semibold mb-4">{i18n.footer.companyInfo}</h4>
        <ul class="space-y-2 text-gray-400 text-sm">
          <li>
            <span class="text-gray-500">{i18n.footer.registrationNumber}:</span><br />
            {company.registrationNumber}
          </li>
          <li>
            <span class="text-gray-500">{i18n.footer.vatNumber}:</span><br />
            {company.vatNumber}
          </li>
        </ul>
        
        <!-- Social linkek -->
        {(company.social.facebook || company.social.instagram) && (
          <div class="flex gap-4 mt-6">
            {company.social.facebook && (
              <a 
                href={company.social.facebook}
                target="_blank"
                rel="noopener noreferrer"
                class="text-gray-400 hover:text-white transition-colors"
                aria-label="Facebook"
              >
                <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z"/>
                </svg>
              </a>
            )}
            {company.social.instagram && (
              <a 
                href={company.social.instagram}
                target="_blank"
                rel="noopener noreferrer"
                class="text-gray-400 hover:text-white transition-colors"
                aria-label="Instagram"
              >
                <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12.315 2c2.43 0 2.784.013 3.808.06 1.064.049 1.791.218 2.427.465a4.902 4.902 0 011.772 1.153 4.902 4.902 0 011.153 1.772c.247.636.416 1.363.465 2.427.048 1.067.06 1.407.06 4.123v.08c0 2.643-.012 2.987-.06 4.043-.049 1.064-.218 1.791-.465 2.427a4.902 4.902 0 01-1.153 1.772 4.902 4.902 0 01-1.772 1.153c-.636.247-1.363.416-2.427.465-1.067.048-1.407.06-4.123.06h-.08c-2.643 0-2.987-.012-4.043-.06-1.064-.049-1.791-.218-2.427-.465a4.902 4.902 0 01-1.772-1.153 4.902 4.902 0 01-1.153-1.772c-.247-.636-.416-1.363-.465-2.427-.047-1.024-.06-1.379-.06-3.808v-.63c0-2.43.013-2.784.06-3.808.049-1.064.218-1.791.465-2.427a4.902 4.902 0 011.153-1.772A4.902 4.902 0 015.45 2.525c.636-.247 1.363-.416 2.427-.465C8.901 2.013 9.256 2 11.685 2h.63zm-.081 1.802h-.468c-2.456 0-2.784.011-3.807.058-.975.045-1.504.207-1.857.344-.467.182-.8.398-1.15.748-.35.35-.566.683-.748 1.15-.137.353-.3.882-.344 1.857-.047 1.023-.058 1.351-.058 3.807v.468c0 2.456.011 2.784.058 3.807.045.975.207 1.504.344 1.857.182.466.399.8.748 1.15.35.35.683.566 1.15.748.353.137.882.3 1.857.344 1.054.048 1.37.058 4.041.058h.08c2.597 0 2.917-.01 3.96-.058.976-.045 1.505-.207 1.858-.344.466-.182.8-.398 1.15-.748.35-.35.566-.683.748-1.15.137-.353.3-.882.344-1.857.048-1.055.058-1.37.058-4.041v-.08c0-2.597-.01-2.917-.058-3.96-.045-.976-.207-1.505-.344-1.858a3.097 3.097 0 00-.748-1.15 3.098 3.098 0 00-1.15-.748c-.353-.137-.882-.3-1.857-.344-1.023-.047-1.351-.058-3.807-.058zM12 6.865a5.135 5.135 0 110 10.27 5.135 5.135 0 010-10.27zm0 1.802a3.333 3.333 0 100 6.666 3.333 3.333 0 000-6.666zm5.338-3.205a1.2 1.2 0 110 2.4 1.2 1.2 0 010-2.4z"/>
                </svg>
              </a>
            )}
          </div>
        )}
      </div>
    </div>
    
    <!-- Copyright + jogi linkek -->
    <div class="border-t border-gray-800 mt-10 pt-8 flex flex-col sm:flex-row justify-between items-center gap-4">
      <p class="text-gray-400 text-sm">
        {i18n.footer.copyright.replace('{year}', currentYear.toString()).replace('{company}', company.legalName)}
      </p>
      
      <div class="flex gap-6 text-sm text-gray-400">
        <a href="/adatvedelem" class="hover:text-white transition-colors">
          {i18n.footer.privacyPolicy}
        </a>
        <a href="/aszf" class="hover:text-white transition-colors">
          {i18n.footer.terms}
        </a>
      </div>
    </div>
  </div>
</footer>

<script>
  const revealBtn = document.getElementById('reveal-contact-btn');
  const contactDetails = document.getElementById('contact-details');
  const btnText = document.getElementById('reveal-btn-text');

  // Rate limiting for reveal button (prevent scraping)
  let lastRevealTime = 0;
  const REVEAL_COOLDOWN = 1000; // 1 second cooldown

  revealBtn?.addEventListener('click', () => {
    const now = Date.now();
    if (now - lastRevealTime < REVEAL_COOLDOWN) {
      return; // Rate limited
    }
    lastRevealTime = now;

    const isHidden = contactDetails?.classList.contains('hidden');

    contactDetails?.classList.toggle('hidden');
    contactDetails?.setAttribute('aria-hidden', (!isHidden).toString());
    revealBtn.setAttribute('aria-expanded', isHidden ? 'true' : 'false');

    // Button text toggle - using i18n from data attributes
    if (btnText) {
      const showText = revealBtn.getAttribute('data-show-text') || 'Show contact';
      const hideText = revealBtn.getAttribute('data-hide-text') || 'Hide';
      btnText.textContent = isHidden ? hideText : showText;
    }

    // GTM conversion tracking
    if (isHidden && window.dataLayer) {
      window.dataLayer.push({
        event: 'contact_reveal',
        event_category: 'engagement',
        event_label: 'footer_contact',
      });
    }
  });
</script>
