---
import { Picture } from 'astro:assets';
import { t, type Locale } from '../../config/i18n';

interface StatItem {
  value: string;
  label: string;
}

interface Props {
  title: string;
  subtitle?: string;
  description: string;
  primaryCta: { text: string; href: string };
  secondaryCta?: { text: string; href: string };
  image: ImageMetadata;
  imageAlt: string;
  stats: StatItem[];
  locale?: Locale;
}

const {
  title,
  subtitle,
  description,
  primaryCta,
  secondaryCta,
  image,
  imageAlt,
  stats,
  locale = 'hu'
} = Astro.props;
---

<section class="hero min-h-[calc(100vh-72px)] flex flex-col">
  <div class="flex-1 container mx-auto px-4 py-8 lg:py-12">
    <div class="grid lg:grid-cols-5 gap-8 lg:gap-12 items-center h-full">
      
      <!-- Szöveg (60% = 3/5) - Mobile first -->
      <div class="lg:col-span-3 flex flex-col justify-center order-2 lg:order-1">
        {subtitle && (
          <span class="text-primary-600 font-semibold text-sm uppercase tracking-wide mb-3">
            {subtitle}
          </span>
        )}
        
        <h1 class="text-3xl sm:text-4xl lg:text-5xl xl:text-6xl font-bold text-gray-900 leading-tight mb-6">
          {title}
        </h1>
        
        <p class="text-lg lg:text-xl text-gray-600 mb-8 max-w-2xl">
          {description}
        </p>
        
        <div class="flex flex-col sm:flex-row gap-4">
          <a 
            href={primaryCta.href}
            class="btn btn-primary"
          >
            {primaryCta.text}
          </a>
          
          {secondaryCta && (
            <a 
              href={secondaryCta.href}
              class="btn btn-secondary"
            >
              {secondaryCta.text}
            </a>
          )}
        </div>
      </div>
      
      <!-- Kép (40% = 2/5) - LCP OPTIMALIZÁLÁS -->
      <div class="lg:col-span-2 order-1 lg:order-2">
        <div class="relative aspect-[4/3] lg:aspect-[3/4] rounded-2xl overflow-hidden shadow-2xl">
          <Picture
            src={image}
            formats={['avif', 'webp']}
            alt={imageAlt}
            class="absolute inset-0 w-full h-full object-cover"
            widths={[400, 600, 800, 1200, 1600]}
            sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 40vw"
            loading="eager"
            decoding="sync"
            fetchpriority="high"
            densities={[1, 2]}
          />
        </div>
      </div>
    </div>
  </div>
  
  <!-- Stats/USP sor - mindig képernyő alján, above the fold -->
  <div class="bg-gray-50 border-t border-gray-100 mt-auto">
    <div class="container mx-auto px-4 py-6 lg:py-8">
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-6 lg:gap-8">
        {stats.map((stat) => (
          <div class="text-center">
            <div class="text-2xl lg:text-3xl xl:text-4xl font-bold text-primary-600 mb-1">
              {stat.value}
            </div>
            <div class="text-sm lg:text-base text-gray-600">
              {stat.label}
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  /* Hero section mindig teljesen kitölti a viewport-ot (header nélkül) */
  .hero {
    min-height: calc(100vh - 72px);
    min-height: calc(100dvh - 72px); /* Dynamic viewport height mobilon */
  }
  
  /* ABOVE THE FOLD - Nincs animáció! */
  /* Csak interakciók vannak, betöltési animáció NINCS */
</style>
