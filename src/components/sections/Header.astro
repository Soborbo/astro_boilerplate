---
import { siteConfig } from '../../config/site.config';
import { t, type Locale } from '../../config/i18n';

interface Props {
  locale?: Locale;
}

const { locale = 'hu' } = Astro.props;
const i18n = t(locale);
const { company } = siteConfig;

const navItems = [
  { label: i18n.nav.home, href: '/' },
  { label: '🧮 Kalkulátor', href: '/calculator', highlight: true },
  { label: i18n.nav.services, href: '/#services' },
  // { label: i18n.nav.about, href: '/rolunk' },       // TODO: Oldal létrehozása után uncomment
  // { label: i18n.nav.pricing, href: '/arak' },       // TODO: Oldal létrehozása után uncomment
  { label: i18n.nav.contact, href: '/#contact' },
];
---

<header 
  id="header" 
  class="fixed top-0 left-0 right-0 z-50 bg-white/95 backdrop-blur-sm shadow-sm transition-all duration-300"
  data-state="full"
>
  <!-- Teljes menü (alapállapot) -->
  <div id="nav-full" class="container mx-auto px-4 py-4 transition-all duration-300">
    <div class="flex items-center justify-between">
      <a href="/" class="flex items-center gap-2" aria-label={siteConfig.name}>
        <img src="/logo.svg" alt="" class="h-8 w-auto" aria-hidden="true" />
        <span class="font-semibold text-lg hidden sm:inline">{siteConfig.name}</span>
      </a>
      
      <nav class="hidden lg:flex items-center gap-8" aria-label="Fő navigáció">
        {navItems.map(item => (
          <a 
            href={item.href} 
            class="text-gray-700 hover:text-primary-600 transition-colors font-medium relative group"
          >
            {item.label}
            <span class="absolute -bottom-1 left-0 w-0 h-0.5 bg-primary-600 transition-all group-hover:w-full"></span>
          </a>
        ))}
      </nav>
      
      <div class="flex items-center gap-4">
        <a 
          href={`tel:${company.contact.phoneRaw}`}
          class="hidden md:flex items-center gap-2 text-gray-700 hover:text-primary-600 transition-colors"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
          </svg>
          <span class="font-medium">{company.contact.phone}</span>
        </a>
        
        <a 
          href="#contact"
          class="hidden lg:inline-flex px-5 py-2.5 bg-primary-600 text-white rounded-lg font-medium hover:bg-primary-700 transition-colors"
        >
          {i18n.common.getQuote}
        </a>
        
        <!-- Hamburger (mobil) -->
        <button 
          id="menu-toggle" 
          class="lg:hidden p-2 text-gray-700 relative w-10 h-10 flex items-center justify-center"
          aria-label="Menü megnyitása"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <span class="hamburger-icon">
            <span></span>
            <span></span>
            <span></span>
          </span>
        </button>
      </div>
    </div>
  </div>
  
  <!-- Kompakt CTA sor (scroll után) -->
  <div id="nav-compact" class="container mx-auto px-4 py-3 hidden transition-all duration-300">
    <div class="flex items-center justify-between">
      <a href="/" class="flex items-center gap-2" aria-label={siteConfig.name}>
        <img src="/logo.svg" alt="" class="h-6 w-auto" aria-hidden="true" />
      </a>
      
      <span class="font-semibold text-gray-900 hidden sm:inline text-sm">{siteConfig.name}</span>
      
      <a 
        href={`tel:${company.contact.phoneRaw}`}
        class="flex items-center gap-2 text-gray-700 hover:text-primary-600 transition-colors"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
        </svg>
        <span class="font-medium hidden md:inline">{company.contact.phone}</span>
      </a>
      
      <a 
        href="#contact"
        class="px-4 py-2 bg-primary-600 text-white rounded-lg font-medium hover:bg-primary-700 transition-colors text-sm"
      >
        {i18n.common.getQuote}
      </a>
    </div>
  </div>
  
  <!-- Mobil menü - Fancy animáció -->
  <div 
    id="mobile-menu" 
    class="lg:hidden fixed inset-0 z-50 pointer-events-none"
    aria-hidden="true"
  >
    <!-- Overlay -->
    <div id="menu-overlay" class="absolute inset-0 bg-black/50 opacity-0 transition-opacity duration-300"></div>
    
    <!-- Menü panel -->
    <nav 
      id="menu-panel"
      class="absolute top-0 right-0 w-[80%] max-w-sm h-full bg-white shadow-2xl transform translate-x-full transition-transform duration-300 ease-out"
      aria-label="Mobil navigáció"
    >
      <!-- Menü fejléc -->
      <div class="flex items-center justify-between p-4 border-b">
        <span class="font-semibold">{siteConfig.name}</span>
        <button 
          id="menu-close"
          class="p-2 text-gray-500 hover:text-gray-700"
          aria-label="Menü bezárása"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>
      
      <!-- Menü linkek - staggered animáció -->
      <div class="p-4">
        <ul class="space-y-1">
          {navItems.map((item, index) => (
            <li 
              class="menu-item opacity-0 transform translate-x-4"
              style={`transition-delay: ${index * 50}ms`}
            >
              <a 
                href={item.href}
                class="block px-4 py-3 text-gray-700 hover:bg-primary-50 hover:text-primary-600 rounded-lg transition-colors font-medium"
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
        
        <!-- CTA -->
        <div class="mt-6 pt-6 border-t menu-item opacity-0 transform translate-x-4" style="transition-delay: 250ms">
          <a 
            href="#contact"
            class="block px-4 py-3 bg-primary-600 text-white rounded-lg font-medium hover:bg-primary-700 transition-colors text-center"
          >
            {i18n.common.getQuote}
          </a>
        </div>
        
        <!-- Kapcsolat -->
        <div class="mt-6 space-y-3 menu-item opacity-0 transform translate-x-4" style="transition-delay: 300ms">
          <a 
            href={`tel:${company.contact.phoneRaw}`}
            class="flex items-center gap-3 px-4 py-2 text-gray-600 hover:text-primary-600 transition-colors"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
            </svg>
            {company.contact.phone}
          </a>
        </div>
      </div>
    </nav>
  </div>
</header>

<!-- Header magasság placeholder -->
<div class="h-[72px]"></div>

<style>
  /* Hamburger ikon animáció */
  .hamburger-icon {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    width: 24px;
    height: 18px;
  }
  
  .hamburger-icon span {
    display: block;
    width: 100%;
    height: 2px;
    background: currentColor;
    border-radius: 2px;
    transition: all 0.3s ease;
    transform-origin: center;
  }
  
  /* Hamburger -> X animáció */
  [aria-expanded="true"] .hamburger-icon span:nth-child(1) {
    transform: translateY(8px) rotate(45deg);
  }
  
  [aria-expanded="true"] .hamburger-icon span:nth-child(2) {
    opacity: 0;
    transform: scaleX(0);
  }
  
  [aria-expanded="true"] .hamburger-icon span:nth-child(3) {
    transform: translateY(-8px) rotate(-45deg);
  }
  
  /* Menü item animáció aktív állapotban */
  .menu-open .menu-item {
    opacity: 1;
    transform: translateX(0);
    transition: opacity 0.3s ease, transform 0.3s ease;
  }
</style>

<script>
  const header = document.getElementById('header');
  const navFull = document.getElementById('nav-full');
  const navCompact = document.getElementById('nav-compact');
  const menuToggle = document.getElementById('menu-toggle');
  const menuClose = document.getElementById('menu-close');
  const mobileMenu = document.getElementById('mobile-menu');
  const menuOverlay = document.getElementById('menu-overlay');
  const menuPanel = document.getElementById('menu-panel');
  
  let lastScrollY = 0;
  let ticking = false;
  
  // Focus trap elemek
  let focusableElements: HTMLElement[] = [];
  let firstFocusable: HTMLElement | null = null;
  let lastFocusable: HTMLElement | null = null;
  
  // Scroll kezelés - csak desktop
  function handleScroll() {
    const currentScrollY = window.scrollY;
    const isDesktop = window.innerWidth >= 1024;
    
    if (!isDesktop) {
      navFull?.classList.remove('hidden');
      navCompact?.classList.add('hidden');
      return;
    }
    
    if (currentScrollY > 50 && currentScrollY > lastScrollY) {
      navFull?.classList.add('hidden');
      navCompact?.classList.remove('hidden');
      header?.setAttribute('data-state', 'compact');
    } else if (currentScrollY < lastScrollY) {
      navFull?.classList.remove('hidden');
      navCompact?.classList.add('hidden');
      header?.setAttribute('data-state', 'full');
    }
    
    lastScrollY = currentScrollY;
    ticking = false;
  }
  
  window.addEventListener('scroll', () => {
    if (!ticking) {
      requestAnimationFrame(handleScroll);
      ticking = true;
    }
  }, { passive: true });
  
  // Mobil menü megnyitás
  function openMenu() {
    mobileMenu?.classList.remove('pointer-events-none');
    mobileMenu?.setAttribute('aria-hidden', 'false');
    menuToggle?.setAttribute('aria-expanded', 'true');
    
    // Animációk
    menuOverlay?.classList.add('opacity-100');
    menuPanel?.classList.remove('translate-x-full');
    mobileMenu?.classList.add('menu-open');
    
    // Body scroll lock
    document.body.style.overflow = 'hidden';
    
    // Focus trap setup
    setupFocusTrap();
  }
  
  // Mobil menü bezárás
  function closeMenu() {
    menuOverlay?.classList.remove('opacity-100');
    menuPanel?.classList.add('translate-x-full');
    mobileMenu?.classList.remove('menu-open');
    menuToggle?.setAttribute('aria-expanded', 'false');
    
    setTimeout(() => {
      mobileMenu?.classList.add('pointer-events-none');
      mobileMenu?.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }, 300);
  }
  
  // Focus trap
  function setupFocusTrap() {
    focusableElements = Array.from(
      menuPanel?.querySelectorAll<HTMLElement>(
        'a[href], button, input, textarea, select, [tabindex]:not([tabindex="-1"])'
      ) || []
    );
    
    firstFocusable = focusableElements[0];
    lastFocusable = focusableElements[focusableElements.length - 1];
    
    firstFocusable?.focus();
  }
  
  function handleFocusTrap(e: KeyboardEvent) {
    if (!mobileMenu?.classList.contains('menu-open')) return;
    
    if (e.key === 'Tab') {
      if (e.shiftKey && document.activeElement === firstFocusable) {
        e.preventDefault();
        lastFocusable?.focus();
      } else if (!e.shiftKey && document.activeElement === lastFocusable) {
        e.preventDefault();
        firstFocusable?.focus();
      }
    }
    
    if (e.key === 'Escape') {
      closeMenu();
      menuToggle?.focus();
    }
  }
  
  // Event listeners
  menuToggle?.addEventListener('click', () => {
    const isOpen = menuToggle.getAttribute('aria-expanded') === 'true';
    isOpen ? closeMenu() : openMenu();
  });
  
  menuClose?.addEventListener('click', closeMenu);
  menuOverlay?.addEventListener('click', closeMenu);
  document.addEventListener('keydown', handleFocusTrap);
  
  // Menü linkekre kattintva bezár
  menuPanel?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', closeMenu);
  });
  
  // Resize kezelés
  window.addEventListener('resize', () => {
    if (window.innerWidth >= 1024) {
      closeMenu();
    }
  });
</script>
