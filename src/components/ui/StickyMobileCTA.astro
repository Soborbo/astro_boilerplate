---
import { siteConfig } from '../../config/site.config';
import { t, type Locale } from '../../config/i18n';

interface Props {
  locale?: Locale;
}

const { locale = 'hu' } = Astro.props;
const i18n = t(locale);
const { company } = siteConfig;
---

<!-- Csak mobilon látható -->
<div 
  id="sticky-mobile-cta" 
  class="lg:hidden fixed bottom-0 left-0 right-0 z-40 bg-white border-t border-gray-200 shadow-lg transform translate-y-full transition-transform duration-300"
  aria-hidden="true"
>
  <div class="container mx-auto px-4 py-3">
    <div class="flex items-center gap-3">
      <!-- Telefonszám -->
      <a 
        href={`tel:${company.contact.phoneRaw}`}
        class="flex-1 flex items-center justify-center gap-2 py-3 bg-gray-100 text-gray-900 rounded-lg font-medium hover:bg-gray-200 transition-colors"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
        </svg>
        <span>{i18n.common.callUs}</span>
      </a>
      
      <!-- CTA gomb -->
      <a 
        href="#contact"
        class="flex-1 flex items-center justify-center gap-2 py-3 bg-primary-600 text-white rounded-lg font-medium hover:bg-primary-700 transition-colors"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
        </svg>
        <span>{i18n.common.getQuote}</span>
      </a>
    </div>
  </div>
  
  <!-- Safe area padding iOS-hez -->
  <div class="h-[env(safe-area-inset-bottom)]"></div>
</div>

<script>
  const stickyCta = document.getElementById('sticky-mobile-cta');
  let ticking = false;
  
  function handleScroll() {
    const isMobile = window.innerWidth < 1024;
    
    if (!isMobile) {
      stickyCta?.classList.add('translate-y-full');
      stickyCta?.setAttribute('aria-hidden', 'true');
      return;
    }
    
    // 200px görgetés után jelenik meg
    if (window.scrollY > 200) {
      stickyCta?.classList.remove('translate-y-full');
      stickyCta?.setAttribute('aria-hidden', 'false');
    } else {
      stickyCta?.classList.add('translate-y-full');
      stickyCta?.setAttribute('aria-hidden', 'true');
    }
    
    ticking = false;
  }
  
  window.addEventListener('scroll', () => {
    if (!ticking) {
      requestAnimationFrame(handleScroll);
      ticking = true;
    }
  }, { passive: true });
  
  window.addEventListener('resize', () => {
    if (window.innerWidth >= 1024) {
      stickyCta?.classList.add('translate-y-full');
      stickyCta?.setAttribute('aria-hidden', 'true');
    }
  });
</script>
