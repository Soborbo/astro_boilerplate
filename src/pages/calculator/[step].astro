---
/**
 * Dynamic Step Page
 * Handles all calculator steps with proper routing
 */

import CalculatorLayout from '@/layouts/CalculatorLayout.astro';
import ProgressBar from '@/components/calculator/ProgressBar.astro';
import SocialProofBar from '@/components/calculator/SocialProofBar.astro';
import RadioCard from '@/components/calculator/RadioCard.astro';
import ChecklistCard from '@/components/calculator/ChecklistCard.astro';
import ContactForm from '@/components/calculator/ContactForm.astro';
import { STEPS, getStepBySlug, getStepIndex, getNextStep, getPrevStep } from '@/config/calculator/steps';
import { getOptionsForStep } from '@/config/calculator/options';
import { siteConfig } from '@/config/calculator/site';
import { i18n } from '@/config/calculator/i18n';

export function getStaticPaths() {
  return STEPS.map(step => ({
    params: { step: step.slug },
  }));
}

const { step: stepSlug } = Astro.params;
const stepConfig = getStepBySlug(stepSlug!);

if (!stepConfig) {
  return Astro.redirect('/calculator/step-1');
}

const stepIndex = getStepIndex(stepSlug!) + 1; // Human-readable (1-based)
const options = getOptionsForStep(stepConfig.id);
const nextStep = getNextStep(stepSlug!);
const prevStep = getPrevStep(stepSlug!);
const t = i18n[siteConfig.locale];
---

<CalculatorLayout title={stepConfig.title} currentStepSlug={stepSlug}>
  <SocialProofBar variant="compact" />
  <ProgressBar currentStep={stepIndex} />

  <main class="py-8 px-4">
    <div class="max-w-4xl mx-auto">

      {/* Step header */}
      <div class="text-center mb-8 animate-fade-in">
        <h1 class="text-2xl md:text-4xl font-bold text-gray-900 mb-3">
          {stepConfig.title}
        </h1>
        {stepConfig.description && (
          <p class="text-lg text-gray-600 max-w-2xl mx-auto">
            {stepConfig.description}
          </p>
        )}
      </div>

      {/* Radio step */}
      {stepConfig.type === 'radio' && (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 animate-fade-in-up">
          {options.map(option => (
            <RadioCard
              id={option.id}
              name={stepConfig.id}
              value={option.value}
              title={option.title}
              description={option.description}
              image={option.image}
              icon={option.icon}
              popular={option.popular}
              autoAdvance={true}
            />
          ))}
        </div>
      )}

      {/* Checkbox step */}
      {stepConfig.type === 'checkbox' && (
        <div class="space-y-3 max-w-2xl mx-auto animate-fade-in-up">
          {options.map(option => (
            <ChecklistCard
              id={option.id}
              name={`${stepConfig.id}[]`}
              value={option.value}
              title={option.title}
              description={option.description}
              icon={option.icon}
              price={option.price}
              popular={option.popular}
            />
          ))}

          {/* Navigation buttons for checkbox step */}
          <div class="flex justify-between items-center pt-6">
            {prevStep && (
              <a
                href={`/calculator/${prevStep.slug}`}
                class="text-gray-600 hover:text-gray-900 transition-colors flex items-center gap-2"
              >
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                </svg>
                {t.back}
              </a>
            )}

            <button
              type="button"
              data-action="next"
              class="
                ml-auto px-8 py-4 bg-primary text-white font-bold rounded-lg
                hover:bg-primary-dark transition-all duration-200 shadow-lg hover:shadow-xl
                focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2
                flex items-center gap-2 group
              "
            >
              <span>{t.next}</span>
              <svg class="w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </button>
          </div>
        </div>
      )}

      {/* Form step */}
      {stepConfig.type === 'form' && (
        <div class="animate-fade-in-up">
          <ContactForm prevStepSlug={prevStep?.slug} />
        </div>
      )}

    </div>
  </main>
</CalculatorLayout>

{/* Client-side logic */}
<script
  type="module"
  define:vars={{
    stepId: stepConfig.id,
    nextStepSlug: nextStep?.slug || null,
    prevStepSlug: prevStep?.slug || null,
    locale: siteConfig.locale,
    isFormStep: stepConfig.type === 'form',
  }}
>
  import {
    initCalculator,
    initEmailTypoCheck,
    initPostcodeLookup,
    captureUTM,
  } from '/src/lib/calculator/client.ts';

  // Capture UTM on first load
  captureUTM();

  // Initialize calculator controller
  initCalculator({
    stepId,
    nextStepSlug,
    prevStepSlug,
  });

  // Form-specific initializations
  if (isFormStep) {
    initEmailTypoCheck();
    initPostcodeLookup(locale);
  }
</script>

<style>
  /* Page transition animations */
  @keyframes fade-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes fade-in-up {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fade-in {
    animation: fade-in 0.5s ease-out;
  }

  .animate-fade-in-up {
    animation: fade-in-up 0.6s ease-out;
  }

  /* Respect user preferences */
  @media (prefers-reduced-motion: reduce) {
    .animate-fade-in,
    .animate-fade-in-up {
      animation: none;
    }
  }
</style>
