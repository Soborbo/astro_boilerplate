# ============================================
# ENVIRONMENT VARIABLES
# ============================================
# 
# ⚠️ FONTOS: NE TÖLTSD FEL A .env FÁJLT!
# 
# Ezeket a változókat a Cloudflare Dashboard-on állítsd be:
# Settings > Environment Variables
# 
# ============================================

# Site URL (public - OK ha publikus)
PUBLIC_SITE_URL=https://example.com

# Google Tag Manager
GTM_ID=GTM-XXXXXXX

# Facebook Pixel (ha kell)
# FB_PIXEL_ID=123456789

# ============================================
# FORM HANDLER (functions/api/submit-form.ts)
# ============================================

# ⚠️ KÖTELEZŐ - CORS védelem
# A te domain-ed, ahonnan a form küldhető
ALLOWED_ORIGIN=https://example.com

# Google Sheets API
# 1. Hozz létre Google Cloud projektet
# 2. Engedélyezd a Sheets API-t
# 3. Hozz létre API kulcsot
GOOGLE_SHEETS_API_KEY=your-api-key
GOOGLE_SHEET_ID=your-sheet-id

# ⚠️ KÖTELEZŐ - Resend Email
# https://resend.com - ingyenes 100 email/nap
# A domain-t VERIFIED-nek kell lennie Resend-ben!
RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_FROM_EMAIL=Form <noreply@yourdomain.com>
NOTIFICATION_EMAIL=info@example.com

# Slack Webhook (opcionális)
# https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/xxx/xxx

# ============================================
# CLOUDFLARE (GitHub Actions CI/CD)
# ============================================

# API Token - Workers & Pages:Edit + Account:Read
CLOUDFLARE_API_TOKEN=your-token
CLOUDFLARE_ACCOUNT_ID=your-account-id

# KV Namespace (rate limiting-hez)
# Létrehozás: wrangler kv:namespace create FORM_SUBMISSIONS
# Ha nincs beállítva, a rate limiting KIKAPCSOLT lesz!
# FORM_SUBMISSIONS_ID=xxxxxxxxxxxxx
