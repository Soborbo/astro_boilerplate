---
/**
 * Email Input Component
 * Email input with typo suggestion feature
 */

import { siteConfig } from '@/config/calculator/site';
import { i18n } from '@/config/calculator/i18n';

interface Props {
  id?: string;
  name?: string;
  required?: boolean;
  value?: string;
  error?: string;
}

const {
  id = 'email',
  name = 'email',
  required = true,
  value,
  error,
} = Astro.props;

const t = i18n[siteConfig.locale];
---

<div class="space-y-1">
  <label for={id} class="block text-sm font-medium text-gray-700">
    {t.email}
    {required && <span class="text-red-500" aria-label="required">{t.required}</span>}
  </label>

  <input
    type="email"
    id={id}
    name={name}
    value={value}
    placeholder="pelda@email.com"
    required={required}
    autocomplete="email"
    class="
      w-full px-4 py-3 bg-white border-2 border-gray-300 rounded-lg
      text-gray-900 placeholder-gray-400
      transition-all duration-200 ease-out
      focus:border-primary focus:ring-2 focus:ring-primary focus:ring-opacity-20 focus:outline-none
      hover:border-gray-400
      invalid:border-red-300 invalid:text-red-900
    "
    aria-invalid={error ? 'true' : 'false'}
    aria-describedby={error ? `${id}-error` : `${id}-suggestion`}
  />

  {/* Email typo suggestion (populated by client.ts) */}
  <div id="email-suggestion" class="hidden p-3 bg-yellow-50 border border-yellow-200 rounded-lg text-sm animate-fade-in">
    <p class="text-yellow-800">
      {t.emailSuggestion}
      <button
        type="button"
        id="email-fix-btn"
        class="ml-1 font-semibold text-primary hover:underline focus:outline-none focus:underline"
      >
        {/* Email suggestion will be inserted here by JS */}
      </button>
    </p>
  </div>

  {error && (
    <p id={`${id}-error`} class="text-sm text-red-600 flex items-center gap-1 animate-fade-in" role="alert">
      <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
        <path
          fill-rule="evenodd"
          d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z"
          clip-rule="evenodd"
        />
      </svg>
      {error}
    </p>
  )}
</div>

<style>
  /* Input focus glow effect */
  input:focus {
    box-shadow: 0 0 0 3px rgba(14, 165, 233, 0.1);
  }

  /* Respect user preferences */
  @media (prefers-reduced-motion: reduce) {
    input,
    #email-suggestion {
      transition: none;
    }
  }
</style>
